{
  "name": "@align/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@align/config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.0"
  }
}
