{
  "name": "lscs-align",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.typecheck.json",
    "test": "node --test tests/*.test.mjs apps/web/test/*.test.mjs apps/api/test/*.test.mjs",
    "test:integration": "node --test apps/api/test/integration/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "build": "npm run build --workspace=@align/web && npm run build --workspace=@align/api",
    "db:migrate": "npm run db:migrate --workspace=@align/api",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "yaml": "^2.8.1"
  }
}
