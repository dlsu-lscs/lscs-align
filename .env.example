# ==============================================================================
# 🛡️ LSCS Align (.env.example)
#
# SECURITY NOTICE:
# 1. Never commit actual secret keys, database credentials, or API tokens to Git.
# 2. Duplicate this file as '.env' or '.env.local' for your local development.
# 3. Production & Staging credentials are synchronized via the official LSCS
#    Bitwarden Vault (tech@dlsu-lscs.org).
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL / SQLite)
# Example: postgresql://postgres:postgres@localhost:5432/lscs_align
DATABASE_URL="file:./dev.db"

# Session & Security Secrets (Generate random 32+ character strings for local)
SESSION_SECRET="dev-insecure-secret-key-change-me-locally"
JWT_SECRET="dev-insecure-jwt-secret-key-change-me-locally"

# CORS & Security Headers
ALLOWED_ORIGINS="http://localhost:3000"

# Rate Limiting Guardrails (Requests per window)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
