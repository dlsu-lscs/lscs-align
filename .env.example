# ==============================================================================
# 🛡️ LSCS Align (.env.example)
#
# SECURITY NOTICE:
# 1. Never commit actual secret keys, database credentials, or API tokens to Git.
# 2. Duplicate this file as '.env' or '.env.local' for your local development.
# 3. Production & Staging credentials are synchronized via the official LSCS
#    Bitwarden Vault (tech@dlsu-lscs.org).
# ==============================================================================

# Application identity
APP_ENV=development
SOURCE_COMMIT=0000000000000000000000000000000000000000
WEB_HOST=0.0.0.0
WEB_PORT=3000
API_HOST=0.0.0.0
API_PORT=4000
APP_ORIGIN=http://localhost:3000

# PostgreSQL connection and isolated roles
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=align_local
EXPECTED_DATABASE_NAME=align_local
DATABASE_RUNTIME_USER=align_app
DATABASE_RUNTIME_PASSWORD=replace-with-a-unique-runtime-password
DATABASE_MIGRATION_USER=align_migrator
DATABASE_MIGRATION_PASSWORD=replace-with-a-unique-migration-password
POSTGRES_ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password

# Server-side session secret. Generate at least 32 random bytes per environment.
SESSION_SECRET=replace-with-a-unique-random-value

# Compose, Dokploy, and Traefik
COMPOSE_PROJECT_NAME=align-local
ROUTER_PREFIX=align-local
APP_DOMAIN=localhost
TRAEFIK_NETWORK=dokploy-network
WEB_IMAGE=ghcr.io/dlsu-lscs/lscs-align-web@sha256:replace-with-web-digest
API_IMAGE=ghcr.io/dlsu-lscs/lscs-align-api@sha256:replace-with-api-digest

# CORS & Security Headers
ALLOWED_ORIGINS=http://localhost:3000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=align-api

# Rate Limiting Guardrails (Requests per window)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
